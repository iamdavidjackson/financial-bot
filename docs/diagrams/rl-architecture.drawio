        <mxCell id="env_obs" parent="env_lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" value="&lt;b&gt;1. Provide Observation&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Daily timestep state:&lt;br/&gt;signals + positions + prices + cash + value&lt;/font&gt;" vertex="1">
          <mxGeometry height="95" width="230" x="45" y="85" as="geometry" />
        </mxCell>
