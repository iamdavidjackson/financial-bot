          <mxGeometry height="95" width="230" x="685" y="85" as="geometry" />
        </mxCell>
        <mxCell id="env_reward" parent="env_lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" value="&lt;b&gt;4. Return Reward&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Reward = change in total portfolio value&lt;br/&gt;after action and costs&lt;/font&gt;" vertex="1">
