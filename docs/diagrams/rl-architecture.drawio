<mxfile host="app.diagrams.net">
  <diagram id="rl-ppo-portfolio-architecture" name="Page-1">
    <mxGraphModel dx="1882" dy="1231" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;verticalAlign=middle;" value="RL Portfolio Agent - PPO Architecture" vertex="1">
          <mxGeometry height="40" width="1100" x="170" y="20" as="geometry" />
        </mxCell>
        <mxCell id="lstm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1B4F72;fontSize=12;arcSize=8;" value="&lt;b&gt;Stage 1: LSTM Signals&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Directional probability per stock&lt;br/&gt;0 = bearish, 1 = bullish&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="230" x="70" y="105" as="geometry" />
        </mxCell>
        <mxCell id="market" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#2980B9;fontSize=12;arcSize=8;" value="&lt;b&gt;Market + Portfolio State&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Current prices, positions,&lt;br/&gt;cash, total portfolio value&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="230" x="70" y="220" as="geometry" />
        </mxCell>
        <mxCell id="obs_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=8;fontColor=#333333;" value="&lt;b&gt;Observation Vector&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Size = 3N + 2&lt;br/&gt;For 5 stocks: 17 values&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="250" x="395" y="105" as="geometry" />
        </mxCell>
        <mxCell id="agent" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;arcSize=8;" value="&lt;b&gt;PPO Agent&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Stable-Baselines3&lt;br/&gt;Learns policy from environment rollouts&lt;/font&gt;" vertex="1">
          <mxGeometry height="88" width="250" x="760" y="101" as="geometry" />
        </mxCell>
        <mxCell id="policy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=8;fontColor=#333333;" value="&lt;b&gt;Actor-Critic Policy Network&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Shared starting point:&lt;br/&gt;MLP 64 - ReLU - 64 - ReLU&lt;br/&gt;Actor chooses actions; critic estimates value&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="250" x="760" y="235" as="geometry" />
        </mxCell>
        <mxCell id="actions" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=8;fontColor=#333333;" value="&lt;b&gt;Action Space&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MultiDiscrete([3] * N)&lt;br/&gt;Per stock: 0 Hold, 1 Buy, 2 Sell&lt;br/&gt;For 5 stocks: 3^5 = 243 joint actions&lt;br/&gt;Scales exponentially with N&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="265" x="1095" y="225" as="geometry" />
        </mxCell>
        <mxCell id="env_lane" parent="1" style="swimlane;html=1;fillColor=#EAFAF1;strokeColor=#1E8449;fontSize=14;fontStyle=1;startSize=38;arcSize=3;swimlaneLine=1;" value="Custom OpenAI Gym Portfolio Environment" vertex="1">
